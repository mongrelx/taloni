# StraightUpProgress (separate project, same OCI instance) — see its own
# DEPLOYMENT.md.
{$SUP_DOMAIN:sup.localhost} {
	reverse_proxy straightupprogress:80
}

# StraightUpBeats (separate project, same OCI instance) — see its own
# DEPLOYMENT.md. Distinct default host so this doesn't collide with the
# block above when neither SUP_DOMAIN nor SUB_DOMAIN is set.
{$SUB_DOMAIN:sub.localhost} {
	reverse_proxy straightupbeats:80
}

# Kuulutin (separate project, same OCI instance) — see its own DEPLOYMENT.md.
# Distinct default host so this doesn't collide with the blocks above when
# neither SUP_DOMAIN, SUB_DOMAIN, nor KUL_DOMAIN is set.
{$KUL_DOMAIN:kul.localhost} {
	reverse_proxy kuulutin:80
}

# landing zone — shared OAuth/cross-device-sync service (separate project, same OCI
# instance) — see its own DEPLOYMENT.md.
{$LZ_DOMAIN:lz.localhost} {
	reverse_proxy landingzone:3000
}

# StraightUpHouses (separate project, same OCI instance) — see its own DEPLOYMENT.md.
{$SUH_DOMAIN:suh.localhost} {
	reverse_proxy straightuphouses:3000
}

# StraightUpHouses (formerly the app that used to live in this repo — split out to
# github.com/mongrelx/StraightUpHouses, which now joins this Caddy's `frontdoor`
# network the same way the sibling projects below do). See its DEPLOYMENT.md.
{$DOMAIN:localhost} {
	reverse_proxy straightuphouses:3000
}

# StraightUpProgress (separate project, same OCI instance) — see its own
# DEPLOYMENT.md. Distinct default host so this doesn't collide with the
# block above when neither DOMAIN nor SUP_DOMAIN is set.
{$SUP_DOMAIN:sup.localhost} {
	reverse_proxy straightupprogress:80
}

# StraightUpBeats (separate project, same OCI instance) — see its own
# DEPLOYMENT.md. Distinct default host so this doesn't collide with the
# blocks above when neither DOMAIN nor SUB_DOMAIN is set.
{$SUB_DOMAIN:sub.localhost} {
	reverse_proxy straightupbeats:80
}
